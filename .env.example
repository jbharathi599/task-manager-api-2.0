# ===== PostgreSQL database =====
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager_user
POSTGRES_PASSWORD=change_me_in_your_own_env_file
POSTGRES_PORT=5432

# ===== JWT (login tokens) =====
# Use a long random string in your real .env file (at least 32 characters).
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRATION_MINUTES=60